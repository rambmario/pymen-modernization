# Copy to .env and adjust. .env is gitignored.
MSSQL_SA_PASSWORD=Your_password123

# JWT signing key (min 32 characters). Prefer user-secrets in Production-like setups.
JWT_SIGNING_KEY=DEV_ONLY_change_me_to_a_long_random_secret

# Demo user passwords (never commit real values; .env is gitignored)
DEMO_PASSWORD_ADMIN=AdminPass123
DEMO_PASSWORD_PLANNER=PlannerPass123
DEMO_PASSWORD_OPERATOR=OperatorPass123

# Azure Service Bus emulator (local docker compose)
ACCEPT_EULA=Y
# Default matches compose service name; override only if needed.
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Azurite (local Blob emulator). Well-known devstoreaccount1 key is public documentation only.
# AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
